{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "./.nuxt/nuxt.d.ts"
    ]
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    ".nuxt/types/*.d.ts",
    "app/**/*",
    "app.config.ts",
    "nuxt.config.ts"
  ]
}
